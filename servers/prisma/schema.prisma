generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int              @id @default(autoincrement())
  email                String           @unique
  password             String?
  name                 String?
  role                 Role             @default(CUSTOMER)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?
  status               UserStatus       @default(PENDING)
  verificationCode     String?
  verificationExpires  DateTime?
  avatar               String?
  phone                String?
  provider             String           @default("LOCAL")
  providerId           String?
  addresses            Address[]
  aiConversations      AiConversation[]
  auditLogs            AuditLog[]
  cart                 Cart?
  sentMessages         ChatMessage[]    @relation("SentMessages")
  discountUsages       DiscountUsage[]
  cancelledOrders      Order[]          @relation("CancelledBy")
  orders               Order[]
  refreshTokens        RefreshToken[]
  returnRequests       ReturnRequest[]
  reviews              Review[]
  wishlistItems        WishlistItem[]
  notificationSettings Json?            @default("{\"orderStatus\":true,\"promotions\":true,\"newsletter\":false,\"security\":true}")
  notifications        Notification[]
  twoFactorEnabled     Boolean          @default(false)
  twoFactorSecret      String?

  @@index([deletedAt])
  @@index([status])
  @@index([provider])
  @@index([providerId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([revoked])
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       PermissionRole[]
}

model PermissionRole {
  role         Role
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([role])
}

model Address {
  id           Int          @id @default(autoincrement())
  userId       Int
  fullName     String
  phone        String
  street       String
  city         String
  state        String?
  zipCode      String?
  country      String?      @default("Vietnam")
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ward         String?
  districtCode String?
  provinceCode String?
  wardCode     String?
  latitude     Float?
  longitude    Float?
  addressType  AddressType? @default(HOME)
  user         User         @relation(fields: [userId], references: [id])
  orders       Order[]

  @@index([userId])
  @@index([userId, isDefault])
  @@index([provinceCode, districtCode, wardCode])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  image              String?
  slug               String?            @unique
  parentId           Int?
  parent             Category?          @relation("CategoryToCategory", fields: [parentId], references: [id])
  children           Category[]         @relation("CategoryToCategory")
  discountCategories DiscountCategory[]
  products           Product[]
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  basePrice        Float
  categoryId       Int?
  brandId          Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  averageRating    Float?
  reviewCount      Int               @default(0)
  soldCount        Int               @default(0)
  isActive         Boolean           @default(true)
  metaDesc         String?
  metaTitle        String?
  slug             String?           @unique
  viewCount        Int               @default(0)
  deletedAt        DateTime?
  originalPrice    Float?
  discountProducts DiscountProduct[]
  brand            Brand?            @relation(fields: [brandId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]

  @@index([categoryId])
  @@index([brandId])
  @@index([averageRating])
  @@index([soldCount])
  @@index([createdAt])
  @@index([categoryId, brandId])
  @@index([isActive])
  @@index([slug])
  @@index([deletedAt])
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int
  url          String
  altText      String?
  isThumbnail  Boolean  @default(false)
  createdAt    DateTime @default(now())
  displayOrder Int      @default(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, displayOrder])
}

model VariantImage {
  id           Int            @id @default(autoincrement())
  variantId    Int
  url          String
  altText      String?
  isPrimary    Boolean        @default(false)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([variantId, displayOrder])
}

model ProductVariant {
  id                Int            @id @default(autoincrement())
  productId         Int
  size              String?
  color             String?
  stock             Int            @default(0)
  price             Float
  sku               String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  isActive          Boolean        @default(true)
  lowStockThreshold Int            @default(5)
  deletedAt         DateTime?
  height            Int?
  length            Int?
  weight            Int?
  width             Int?
  originalPrice     Float?
  cartItems         CartItem[]
  orderItems        OrderItem[]
  product           Product        @relation(fields: [productId], references: [id])
  images            VariantImage[]
  wishlistItems     WishlistItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([isActive])
  @@index([deletedAt])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?       @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime?
  user      User?      @relation(fields: [userId], references: [id])
  cartItems CartItem[]

  @@index([expiresAt])
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Discount {
  id                     Int                @id @default(autoincrement())
  code                   String             @unique
  description            String?
  percentage             Float?
  fixedAmount            Float?
  startDate              DateTime
  endDate                DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  image                  String?
  isActive               Boolean            @default(true)
  maxDiscountAmount      Float?
  minOrderAmount         Float?             @default(0)
  usageCount             Int                @default(0)
  usageLimit             Int?
  isFlashSale            Boolean            @default(false)
  deletedAt              DateTime?
  applicableToCategories DiscountCategory[]
  applicableToProducts   DiscountProduct[]
  discountUsages         DiscountUsage[]
  orders                 Order[]

  @@index([code])
  @@index([isActive])
  @@index([isFlashSale])
  @@index([deletedAt])
  @@index([startDate, endDate])
}

model DiscountCategory {
  discountId Int
  categoryId Int
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([discountId])
  @@index([categoryId])
}

model DiscountProduct {
  discountId  Int
  productId   Int
  stockLimit  Int      @default(0)
  soldCount   Int      @default(0)
  badge       String?
  percentage  Float?
  fixedAmount Float?
  createdAt   DateTime @default(now())
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([discountId])
  @@index([productId])
}

model Review {
  id        Int           @id @default(autoincrement())
  userId    Int
  rating    Int
  comment   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  productId Int
  orderId   Int
  verified  Boolean       @default(false)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    ReviewImage[]

  @@unique([userId, productId, orderId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([rating])
  @@index([verified])
}

model ReviewImage {
  id       Int    @id @default(autoincrement())
  reviewId Int
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ShippingMethod {
  id            Int      @id @default(autoincrement())
  name          String
  price         Float
  estimatedDays Int
  createdAt     DateTime @default(now())
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([isActive])
}

model Order {
  id               Int             @id @default(autoincrement())
  userId           Int?
  addressId        Int?
  shippingMethodId Int?
  total            Float
  taxAmount        Float           @default(0)
  status           OrderStatus     @default(PENDING)
  discountId       Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  guestEmail       String?
  guestPhone       String?
  orderCode        String?         @unique
  cancelReason     String?
  cancelledAt      DateTime?
  cancelledBy      Int?
  shippingSnapshot Json?
  statusHistory    Json[]          @default([]) 
  deletedAt        DateTime?
  discountAmount   Float           @default(0)
  subtotal         Float
  paymentMethod    String          @default("CASH")
  shippingFee      Float           @default(0)
  shippingCode     String?
  shippingLog      Json?
  deliveredAt      DateTime?
  discountUsage    DiscountUsage?
  address          Address?        @relation(fields: [addressId], references: [id])
  cancelledByUser  User?           @relation("CancelledBy", fields: [cancelledBy], references: [id])
  discount         Discount?       @relation(fields: [discountId], references: [id])
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  user             User?           @relation(fields: [userId], references: [id])
  orderItems       OrderItem[]
  payment          Payment?        @relation("OrderPayment")
  returnRequests   ReturnRequest[]
  reviews          Review[]

  @@index([userId])
  @@index([guestEmail])
  @@index([addressId])
  @@index([shippingMethodId])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([orderCode])
  @@index([deletedAt])
  @@index([cancelledBy])
}

model DiscountUsage {
  id         Int      @id @default(autoincrement())
  userId     Int?
  discountId Int
  orderId    Int      @unique
  createdAt  DateTime @default(now())
  guestEmail String?
  guestPhone String?
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guestEmail])
  @@index([guestPhone])
  @@index([discountId])
}

model ReturnRequest {
  id           Int          @id @default(autoincrement())
  orderId      Int
  userId       Int?
  reason       String
  details      String?
  images       String[]     @default([])
  status       ReturnStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  refundAmount Float        @default(0)
  returnItems  ReturnItem[]
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id              Int           @id @default(autoincrement())
  returnRequestId Int
  orderItemId     Int
  quantity        Int
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([orderItemId])
}

model Payment {
  id                     Int           @id @default(autoincrement())
  orderId                Int           @unique
  amount                 Float
  method                 PaymentMethod @default(CASH)
  status                 PaymentStatus @default(PENDING)
  transactionId          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  paymentLink            String?
  payosOrderCode         String?       @unique
  failureReason          String?
  paymentGatewayResponse Json?
  refundAmount           Float?
  refundedAt             DateTime?
  order                  Order         @relation("OrderPayment", fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([payosOrderCode])
  @@index([status])
  @@index([method])
}

model OrderItem {
  id              Int            @id @default(autoincrement())
  orderId         Int
  variantId       Int
  quantity        Int
  price           Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  productName     String
  variantSnapshot Json?
  weight          Int?
  originalPrice   Float?
  order           Order          @relation(fields: [orderId], references: [id])
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  returnItems     ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

model Banner {
  id           Int       @id @default(autoincrement())
  title        String
  subtitle     String?
  image        String
  video        String?
  link         String?
  buttonText   String?   @default("Mua ngay")
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([isActive])
  @@index([deletedAt])
}

model WishlistItem {
  id        Int            @id @default(autoincrement())
  userId    Int
  variantId Int
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
}

model ChatMessage {
  id          Int           @id @default(autoincrement())
  roomId      String
  senderId    Int
  message     String
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  attachments String[]      @default([])
  deletedAt   DateTime?
  messageType MessageType   @default(TEXT)
  repliedToId Int?
  repliedTo   ChatMessage?  @relation("Replies", fields: [repliedToId], references: [id])
  replies     ChatMessage[] @relation("Replies")
  sender      User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([roomId, deletedAt])
  @@index([repliedToId])
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             Int            @id @default(autoincrement())
  conversationId String
  content        String
  productIds     Int[]          @default([])
  createdAt      DateTime       @default(now())
  role           AiRole
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityName String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityName, entityId])
  @@index([createdAt])
}

enum Role {
  CUSTOMER
  ADMIN
  KHO
  BAN_HANG
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  RETURNING
  RECEIVED
}

enum PaymentMethod {
  CASH
  CARD
  VNPAY
  MOMO
  PAYOS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum AiRole {
  USER
  MODEL
  SYSTEM
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  content   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}