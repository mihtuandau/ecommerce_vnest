generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int           @id @default(autoincrement())
  email                String        @unique
  password             String
  name                 String?
  role                 Role          @default(CUSTOMER)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  orders               Order[]
  cart                 Cart?
  addresses            Address[]
  reviews              Review[]
  wishlistItems        WishlistItem[]
  sentMessages         ChatMessage[] @relation("SentMessages")
}

enum Role {
  CUSTOMER
  ADMIN
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  fullName     String
  phone        String
  street       String
  ward         String?  // Phường/Xã
  city         String   // Tỉnh/Thành phố
  state        String?  // Quận/Huyện
  zipCode      String?
  country      String?  @default("Vietnam")
  isDefault    Boolean  @default(false)
  addressType  String?  @default("home") // home, office, other
  user         User     @relation(fields: [userId], references: [id])
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  logo      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            Int              @id @default(autoincrement())
  name          String
  description   String?
  basePrice     Float
  categoryId    Int
  brandId       Int?
  soldCount     Int              @default(0) // Số lượng đã bán
  averageRating Float?           // Đánh giá trung bình
  reviewCount   Int              @default(0) // Số lượng review
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]         // Thêm relation với Review
  category      Category         @relation(fields: [categoryId], references: [id])
  brand         Brand?           @relation(fields: [brandId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id          Int             @id @default(autoincrement())
  product     Product         @relation(fields: [productId], references: [id])
  productId   Int
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantId   Int? // mới: optional FK
  url         String
  altText     String?
  isThumbnail Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

model ProductVariant {
  id            Int            @id @default(autoincrement())
  productId     Int
  size          String?
  color         String?
  stock         Int            @default(0)
  price         Float
  sku           String?
  product       Product        @relation(fields: [productId], references: [id])
  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int            @default(1)
  cart      Cart           @relation(fields: [cartId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Discount {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String?
  image       String?   // URL ảnh banner khuyến mãi
  percentage  Float?
  fixedAmount Float?
  startDate   DateTime
  endDate     DateTime?
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  orderId   Int      // Thêm orderId để gắn review với đơn hàng cụ thể
  rating    Int      // 1-5 sao
  comment   String?  @db.Text
  images    String[] // Mảng URLs hình ảnh review
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, orderId]) // 1 user chỉ review 1 product 1 lần trong 1 đơn hàng
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([rating])
}

model ShippingMethod {
  id            Int      @id @default(autoincrement())
  name          String
  price         Float
  estimatedDays Int
  orders        Order[]
  createdAt     DateTime @default(now())
}

model Order {
  id               Int             @id @default(autoincrement())
  orderCode        String?         @unique // Mã đơn hàng dạng chuỗi
  userId           Int?            // Nullable for guest checkout
  addressId        Int?
  shippingMethodId Int?
  shippingAddress  String?         // Địa chỉ giao hàng dạng text
  shippingInfo     Json?           // Thông tin người nhận {fullName, phone, note}
  guestEmail       String?         // Email for guest orders
  guestPhone       String?         // Phone for guest orders
  paymentMethod    PaymentMethod?  @default(CASH) // Phương thức thanh toán
  total            Float
  taxAmount        Float           @default(0)
  status           OrderStatus     @default(PENDING)
  discountId       Int?
  paymentId        Int?            @unique
  discount         Discount?       @relation(fields: [discountId], references: [id])
  payment          Payment?        @relation // Fix: Chỉ @relation() – không fields/references (referencing side)
  address          Address?        @relation(fields: [addressId], references: [id])
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  user             User?           @relation(fields: [userId], references: [id])
  orderItems       OrderItem[]
  reviews          Review[]        // Thêm relation với Review
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([guestEmail])
  @@index([addressId])
  @@index([shippingMethodId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int           @unique
  amount          Float
  method          PaymentMethod @default(CASH)
  status          PaymentStatus @default(PENDING)
  transactionId   String?
  paymentLink     String?       // URL payment link từ PayOS
  payosOrderCode  BigInt?       @unique // Order code từ PayOS
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([payosOrderCode])
}

enum PaymentMethod {
  CASH
  CARD
  VNPAY
  MOMO
  PAYOS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

model OrderItem {
  id        Int            @id @default(autoincrement())
  orderId   Int
  variantId Int
  quantity  Int
  price     Float
  order     Order          @relation(fields: [orderId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([orderId])
  @@index([variantId])
}

model Banner {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String?
  image       String
  video       String?
  link        String?
  buttonText  String?  @default("Mua ngay")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WishlistItem {
  id        Int            @id @default(autoincrement())
  userId    Int
  variantId Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
}

model ChatMessage {
  id         Int          @id @default(autoincrement())
  roomId     String       // Unique room per user-admin conversation
  senderId   Int
  message    String       @db.Text
  isRead     Boolean      @default(false)
  sender     User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
}
