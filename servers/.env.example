# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/ecommerce?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
# IMPORTANT: Generate a secure random secret for production
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your-very-secure-random-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-secure-refresh-secret-key-min-32-chars

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Security
PROXY_SECRET=your-super-secret-key-here-change-in-production

# CSP (Content Security Policy) Configuration
# CSP_REPORT_URI=/api/security/csp-report  # Optional: endpoint to receive CSP violations

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password-from-google
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=E-Commerce Shop

# Third-party Services
# ⚠️  CLOUDINARY_CLOUD_NAME (đổi từ CLOUDINARY_NAME để khớp docker-compose)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@yourdomain.com

# Payment Services
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

VN_PAY_TMN_CODE=your-vnpay-tmncode
VN_PAY_SECRET_KEY=your-vnpay-secret-key

# Redis Cache (required for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_CACHE_EXPIRATION=3600
USE_REDIS_CACHE=true

# External APIs
OPENAI_API_KEY=your-openai-api-key
# ⚠️  GEMINI_API_KEY (đổi từ GOOGLE_GENERATIVE_AI_KEY để khớp docker-compose)
GEMINI_API_KEY=your-google-generative-ai-key

# GHTK Shipping (required for shipping integration)
GHTK_API_URL=https://services.giaohangtietkiem.vn
GHTK_TOKEN=your-ghtk-token
